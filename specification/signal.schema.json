{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.fxvnpro.com/fxotp/schema/signal-v0.1.json",
  "title": "FXVN Open Trading Protocol Signal",
  "description": "Schema for an FXOTP structured trading instruction.",
  "type": "object",

  "required": [
    "protocol",
    "version",
    "id",
    "created_at",
    "instrument",
    "action"
  ],

  "properties": {
    "protocol": {
      "type": "string",
      "const": "FXOTP"
    },

    "version": {
      "type": "string",
      "const": "0.1"
    },

    "id": {
      "type": "string",
      "minLength": 1
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "instrument": {
      "type": "object",
      "required": [
        "symbol",
        "asset_class"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "forex",
            "metal",
            "crypto",
            "index",
            "commodity",
            "stock",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },

    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL",
        "CLOSE",
        "MODIFY",
        "CANCEL"
      ]
    },

    "entry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "market",
            "limit",
            "stop"
          ]
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },

    "stop_loss": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "price"
      ],
      "additionalProperties": false
    },

    "take_profit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "price"
        ],
        "additionalProperties": false
      }
    },

    "risk": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "percent",
            "fixed_lot",
            "fixed_amount"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },

    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },

  "additionalProperties": false
}
